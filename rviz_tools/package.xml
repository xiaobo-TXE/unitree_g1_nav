<?xml version="1.0"?>
<package format="3">
  <name>rviz_tools</name>
  <version>1.0.0</version>
  <description>
    RViz2 plugins for 3D Pose Estimate and 3D Nav Goal.
    Supports full XYZ position with yaw orientation via OpenGL depth picking.
  </description>

  <maintainer email="wangjie19990110@gmail.com">jiewang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>

  <build_depend>Qt5Widgets</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz_common plugin="${prefix}/plugins_description.xml"/>
  </export>
</package>
