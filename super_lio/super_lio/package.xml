<package format="3">
  <name>super_lio</name>
  <version>2.0.0</version>
  <description>The super_lio package</description>
  <maintainer email="lswang@mail.ecust.edu.cn">LS.Wang</maintainer>

  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>nav_msgs</depend>
  <!-- Optional at build time: CMake finds it QUIET and compiles the CustomMsg
       branch out when it is absent, so a non-Livox rig needs no Livox driver.
       Kept as a <depend> so colcon still orders the build correctly on the
       rigs where the driver lives in this same workspace. -->
  <depend>livox_ros_driver2</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>basic</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>