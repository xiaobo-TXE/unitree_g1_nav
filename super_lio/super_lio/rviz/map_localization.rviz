Panels:
  - Class: rviz_common/Displays
    Height: 800
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 40
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    # The prior map, published on a decaying timer after startup.
    - Alpha: 0.4
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 150; 150; 150
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: PriorMap
      Position Transformer: XYZ
      Size (Pixels): 1
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /loc/map
      Use Fixed Frame: true
      Value: true
    # The keyframes actually being matched against right now.
    - Alpha: 0.9
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 200; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Submap
      Position Transformer: XYZ
      Size (Pixels): 2
      Size (m): 0.06
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /loc/submap
      Use Fixed Frame: true
      Value: true
    # The live scan, in the world frame from the frontend. If localization is
    # healthy this sits on top of the submap.
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 170; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LiveScan
      Position Transformer: XYZ
      Size (Pixels): 2
      Size (m): 0.04
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lio/cloud_world
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Alpha: 1
      Arrow Length: 0.3
      Color: 0; 255; 0
      Enabled: true
      Name: Keyframes
      Shape: Arrow (Flat)
      Topic:
        Depth: 2
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /loc/keyframes
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 300
      Name: LocOdom
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Color: 255; 25; 0
        Head Length: 0.15
        Head Radius: 0.1
        Shaft Length: 0.4
        Shaft Radius: 0.04
        Value: Arrow
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /loc/odom
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 35
    # map, not world: the whole point is to see the corrected pose.
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    # Publishes /initialpose, which map_localization_node subscribes to.
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 40
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.8
      Target Frame: <Fixed Frame>
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
